# ── فایل نمونه تنظیمات ──
# این فایل را به نام `.env` کپی کنید و مقادیر واقعی را در آن بگذارید.
# فایل .env هرگز به گیت‌هاب آپلود نمی‌شود (در .gitignore آمده است).

# 🔑 توکن ربات از @BotFather (اجباری)
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 👑 آی‌دی عددی ادمین‌ها — چند نفر را با کاما جدا کنید
ADMIN_IDS=111613881

# 🌐 پروکسی — روی سرور خارج از ایران خالی بگذارید
# v2rayN : socks5h://127.0.0.1:10808  یا  http://127.0.0.1:10809
# Clash  : http://127.0.0.1:7890
PROXY_URL=

# ⚙️ تنظیمات اختیاری (پیش‌فرض در config.py تعریف شده)
# API_POOL_SIZE=64
# UPDATES_POOL_SIZE=4
# CONCURRENT_UPDATES=64
